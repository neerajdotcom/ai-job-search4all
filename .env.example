# ==============================================================================
# Model Providers (Choose any — Groq & Gemini have generous free tiers)
# ==============================================================================

# Groq (Recommended default for high-volume, instant fit scoring)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Recommended for structured resume tailoring and extraction)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative Providers (OpenAI / Anthropic / OpenRouter / Ollama)
# LLM_PROVIDER=groq
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OLLAMA_HOST=http://localhost:11434

# ==============================================================================
# Observability & Tracing (Optional — Local JSON traces active by default)
# ==============================================================================
# Comet Opik Tracing (https://www.comet.com/docs/opik/)
# OPIK_API_KEY=your_opik_api_key_here
# OPIK_PROJECT_NAME=job-scout

# ==============================================================================
# Optional Job Search Feeds (Zero-Key LinkedIn & Remotive active by default)
# ==============================================================================
# Adzuna (Optional free aggregator API — sign up at developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Sourcing Feature Flags
ENABLE_LINKEDIN_SCRAPE=true
ENABLE_REMOTIVE_SCRAPE=true
ENABLE_ATS_SCRAPING=true
ENABLE_CRAWL4AI=false

# ==============================================================================
# Email & Digest Notifications (Optional — for scheduled runs or web sharing)
# ==============================================================================
# Gmail App Password (myaccount.google.com -> Security -> App Passwords)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
DIGEST_RECIPIENT=your_email@example.com
